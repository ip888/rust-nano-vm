# scripts/launch/.env — operator secrets for the production launch.
#
# NEVER commit this file with real values. `scripts/launch/.gitignore`
# excludes the real `.env`; this `.env.example` is the safe-to-share
# template.
#
# Every launch script reads from `scripts/launch/.env` (auto-loaded
# by `preflight.sh` and every other script via `set -a && source
# ...env`).
#
# Fill in every value marked `REQUIRED`. Optional values default to
# something sensible.

# =============================================================================
# Domain + branding
# =============================================================================

# REQUIRED — root marketing domain, no scheme, no trailing slash.
NANOVM_DOMAIN=nanovm.example.com

# REQUIRED — API subdomain of the domain above.
NANOVM_API_DOMAIN=api.nanovm.example.com

# =============================================================================
# Cloudflare (DNS + SSL)
# =============================================================================

# REQUIRED — API token with `Zone:DNS:Edit` scoped to the specific zone.
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=cf_...

# REQUIRED — Zone ID for the domain. Cloudflare shows it on the
# domain's Overview page (right sidebar).
CLOUDFLARE_ZONE_ID=abcdef0123456789

# =============================================================================
# Vercel (marketing site host)
# =============================================================================

# REQUIRED — Vercel account token with deploy scope.
# Create at: https://vercel.com/account/tokens
VERCEL_TOKEN=vercel_...

# Optional — override the project name. Defaults to `nanovm-web`.
VERCEL_PROJECT=nanovm-web

# =============================================================================
# Fly.io (control-plane host — needs /dev/kvm)
# =============================================================================

# REQUIRED — Fly personal access token. Create with `flyctl auth token`
# after `flyctl auth login`.
FLY_API_TOKEN=fly_...

# Optional — app name. Defaults to `nanovm-control-plane-prod`. Must be
# globally unique across all Fly users.
NANOVM_FLY_APP=nanovm-control-plane-prod

# Optional — primary region. `iad` (Ashburn, VA) is Fly's default.
NANOVM_FLY_REGION=iad

# Optional — machine kind. `performance-2x` exposes /dev/kvm.
# `shared-cpu-*` DOES NOT — those are unusable for the KVM backend.
NANOVM_FLY_MACHINE_KIND=performance-2x

# =============================================================================
# Stripe (billing)
# =============================================================================

# REQUIRED — secret key. Start with `sk_test_...` for launch prep,
# switch to `sk_live_...` when ready for real charges.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# REQUIRED after `stripe-webhook.sh` runs — webhook signing secret.
# Print out at the end of `stripe-webhook.sh`.
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...

# REQUIRED after `stripe-setup.sh` runs — price IDs for each tier
# concatenated in NANOVM_PLAN_TIERS format below. Printed at end of
# `stripe-setup.sh`.
STRIPE_PRICE_ID_FREE=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...

# =============================================================================
# Email (magic-link delivery)
# =============================================================================

# REQUIRED — SMTP URL for magic-link email. Postmark example:
#   smtps://<POSTMARK_SERVER_TOKEN>:<POSTMARK_SERVER_TOKEN>@smtp.postmarkapp.com:465
# SendGrid example:
#   smtps://apikey:<SENDGRID_API_KEY>@smtp.sendgrid.net:465
# Resend example:
#   smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
NANOVM_SMTP_URL=smtps://apikey:...@smtp.postmarkapp.com:465

# REQUIRED — verified sender address. Must be on a domain with SPF/DKIM
# records that authorize the email provider above.
NANOVM_SMTP_FROM=hello@nanovm.example.com

# =============================================================================
# Server-side auth + governance
# =============================================================================

# REQUIRED — the signup gate. If your signup route is open, pick a
# 32+ character random string; the server rejects signup requests
# without this header.
# Generate: `openssl rand -hex 32`
NANOVM_SIGNUP_TOKEN=

# REQUIRED — the operator's own bootstrap admin token, so you can
# hit /v1/keys yourself and mint the demo tenant's token.
# Generate: `openssl rand -hex 32`
# Format: <org_id>:<token>@<role>
NANOVM_OPERATOR_TOKEN=operator:CHANGEME@admin

# =============================================================================
# Snapshot store (for /v1/snapshots/:id/export + import)
# =============================================================================

# Optional — S3 bucket URL for snapshot export/import. Leave empty to
# disable the endpoints (default). See docs/enterprise-audit.md for
# the full env surface if you use AWS SES + KMS-encrypted storage.
NANOVM_SNAPSHOT_STORE_URL=

# =============================================================================
# Public demo tenant
# =============================================================================

# Optional but strongly recommended — a token that lives on the
# landing page. Flips the LiveForkBenchmark from "Seeded" to "Live".
# Generate a token AFTER first fly-deploy, via the operator flow.
NEXT_PUBLIC_NANOVM_DEMO_TOKEN=

# Optional — the marketplace snapshot name the demo tenant forks.
# Defaults to `python-3.12-minimal` if empty.
NEXT_PUBLIC_NANOVM_DEMO_MARKETPLACE_NAME=python-3.12-minimal

# =============================================================================
# Observability (optional — but strongly recommended)
# =============================================================================

# Optional — Grafana Cloud endpoint for Prometheus remote_write.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_API_KEY=

# =============================================================================
# GitHub (for the runbook's smoke tests + PR bookkeeping)
# =============================================================================

# Optional — enables `smoke.sh` to open a PR pinning the launched
# version. `gh auth login` is the alternative.
GITHUB_TOKEN=
