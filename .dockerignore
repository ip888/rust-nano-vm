# Keep the Docker build context as small as possible: only the source
# the builder stage actually compiles.

# Build outputs — `cargo build` inside the container regenerates these.
target/

# VCS metadata.
.git/
.gitignore
.github/

# Editor / OS junk.
.idea/
.vscode/
.DS_Store
*.swp

# Docs and bench / dev tooling — not needed for the control plane build.
docs/
# `tools/*` (with the wildcard, NOT `tools/`) leaves the `tools/`
# directory itself traversable while excluding its children —
# `.dockerignore` follows the same "cannot re-include a child under an
# excluded parent" rule as `.gitignore`, so `!tools/kvm-images/…` would
# be a no-op if `tools/` were the excluded entry. Dockerfile.kvm's
# `kvm-images` stage COPYs `tools/kvm-images/fetch.sh` to fetch the
# bundled Firecracker vmlinux + Alpine rootfs into the runtime image.
tools/*
!tools/kvm-images
!tools/kvm-images/**

# Repo policy + docs files. (cargo doesn't need README.md or LICENSE
# to compile the workspace; they ride the source tarball instead.)
README.md
CHANGELOG.md
LICENSE-APACHE
LICENSE-MIT
deny.toml
clippy.toml
rustfmt.toml

# Don't copy the Dockerfile or .dockerignore into the build context;
# they're not consumed by `cargo build` and only inflate the layer.
Dockerfile
.dockerignore
