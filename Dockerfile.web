# syntax=docker/dockerfile:1.7
#
# Multi-stage build for the nanovm-web Next.js site.
# Stage 1 (builder): full Node.js Alpine image with dev deps, runs
#   `next build` to produce `.next/standalone` + `.next/static`.
# Stage 2 (runtime): distroless-node — no shell, no package manager,
#   no unrelated userland. Total image size ~120 MiB.
#
# Layer order is optimised for Fly.io remote builder cache: package
# manifest first, then everything else. A change to source code
# rebuilds only stage-1's copy + build; the deps layer stays cached.
#
# All COPYs into the runtime stage use `--chown=nonroot:nonroot` so
# the distroless `nonroot` user (UID 65532) owns the files. Next.js
# writes to `.next/cache/` during ISR revalidation, so root-owned
# files there would cause silent write failures in production.

FROM node:26-alpine AS builder
WORKDIR /app

# Install deps against the lockfile in a dedicated layer.
COPY web/package.json web/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

# Copy sources and build. next.config.ts uses `output: "standalone"`
# so the produced `.next/standalone/` contains a self-contained
# server + only the runtime deps it needs — the ~200 MiB
# `node_modules/` never rides to the runtime image.
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ------------------------------------------------------------------
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
WORKDIR /app

# Standalone bundle + Next's static assets + user-facing public dir.
# `--chown=nonroot:nonroot` gives the runtime user write access to
# `.next/cache` for ISR-driven fetch revalidations. `public/` is
# owned but never written — safe either way.
COPY --from=builder --chown=nonroot:nonroot /app/.next/standalone ./
COPY --from=builder --chown=nonroot:nonroot /app/.next/static ./.next/static
COPY --from=builder --chown=nonroot:nonroot /app/public ./public

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

EXPOSE 3000
CMD ["server.js"]
